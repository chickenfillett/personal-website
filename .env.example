# Selects the standalone Next.js runtime. Static deployments use npm run build:static.
DEPLOY_TARGET=server
HOSTNAME=0.0.0.0
PORT=3000

# Reserved for future server features. Keep real values in deployment secrets.
# DATABASE_URL=

# --- 轻量统计（L4/L5）：休眠态，默认关闭；当前不收集任何数据 ---
# 启用前需同时：部署 services/analytics 服务端、填入下方端点、确认合规（见 docs/ANALYTICS.md）。
# 仅当显式置为 true 且端点非空时才产生上报；尊重 DNT / GPC / prefers-reduced-motion。
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

